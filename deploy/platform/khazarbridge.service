# /etc/systemd/system/khazarbridge.service
# systemctl daemon-reload && systemctl enable --now khazarbridge
[Unit]
Description=Khazar Bridge platform (Next.js)
After=network.target

[Service]
Type=simple
User=khazar
WorkingDirectory=/srv/khazarbridge/current
EnvironmentFile=/srv/khazarbridge/shared/.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000
Restart=always
RestartSec=5
# База и загрузки лежат вне релиза, переживают выкатку
ReadWritePaths=/srv/khazarbridge/shared
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
MemoryMax=2G

[Install]
WantedBy=multi-user.target
